{
  "name": "the-proportional-house",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": ".venv/bin/python data-pipeline/update.py",
    "pipeline:refresh": ".venv/bin/python data-pipeline/update.py --refresh",
    "predeploy": "test -x .venv/bin/python || (echo 'venv missing — run: python3 -m venv .venv && .venv/bin/pip install -r data-pipeline/requirements.txt' && exit 1)",
    "deploy": "npm run pipeline && npm run build && wrangler pages deploy dist --project-name=the-proportional-house --branch=main"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^2.15.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.10",
    "@types/node": "^25.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.92.0"
  }
}
